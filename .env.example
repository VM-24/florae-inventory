# PostgreSQL connection string
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/florae_inventory

# Secret for signing JWT session tokens. REQUIRED in production (long random string).
JWT_SECRET=change-me-to-a-long-random-string

# First admin, created on startup only when the users table is empty.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please

# HTTP port
PORT=3000

# Where uploaded item photos are stored (mount a persistent volume here in production)
# UPLOADS_DIR=./uploads
