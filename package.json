{
  "name": "florae-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurant inventory (tableware, glassware, equipment) — CRUD panel",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:frou-frou": "tsx prisma/seed-frou-frou.ts",
    "db:clear": "tsx scripts/clearData.ts",
    "user:create": "tsx scripts/createUser.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web install && npm --prefix web run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "prisma": "^5.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.1"
  }
}
